{
  "name": "@yankewei/pi-web-search",
  "version": "0.1.3",
  "description": "pi extension that exposes provider-native web search and routes compatible DeepSeek models through each provider's Responses API",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankewei/pi-web-search.git"
  },
  "homepage": "https://github.com/yankewei/pi-web-search#readme",
  "bugs": {
    "url": "https://github.com/yankewei/pi-web-search/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "deepseek",
    "responses-api"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/index.test.ts",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.3 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.3 <0.85.0"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
